# Open Notebook Production Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Required: Your Open Notebook instance URL
# Use the domain configured in your reverse proxy
OPEN_NOTEBOOK_URL=https://<your-domain.com>

# Required: Your Open Notebook password (set during deployment)
OPEN_NOTEBOOK_PASSWORD=your-secure-password-here

# Optional: Disable SSL verification (only for testing with self-signed certs)
# OPEN_NOTEBOOK_INSECURE=false

# Optional: Cloudflare API token (for certbot DNS-01 challenge)
# Only needed if running Ansible deployment from this machine
# CLOUDFLARE_API_TOKEN=your-cloudflare-token

# Optional: Open Notebook secrets for docker-compose
# OPEN_NOTEBOOK_ENCRYPTION_KEY=your-encryption-key-here
