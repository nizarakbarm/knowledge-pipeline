#!/usr/bin/env bash
# Open Notebook CLI wrapper
# Automatically activates the virtual environment before running the Python CLI.
# Usage: open-notebook <command> [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check .venv first, then venv
if [ -f "${SCRIPT_DIR}/.venv/bin/activate" ]; then
    source "${SCRIPT_DIR}/.venv/bin/activate"
elif [ -f "${SCRIPT_DIR}/venv/bin/activate" ]; then
    source "${SCRIPT_DIR}/venv/bin/activate"
else
    echo "Error: No virtual environment found (tried .venv and venv)" >&2
    echo "Please run: python3 -m venv ${SCRIPT_DIR}/venv" >&2
    exit 1
fi

python3 "${SCRIPT_DIR}/open_notebook.py" "$@"
